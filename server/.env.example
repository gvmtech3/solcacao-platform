PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/solcacao
MONGO_URI_TEST=mongodb://localhost:27017/solcacao_test
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
COOKIE_NAME=solcacao_token
# Only set to true once the site is served over HTTPS - a Secure cookie is
# silently dropped by the browser over plain HTTP. Leave unset to default to
# NODE_ENV==='production'; override to "false" for an HTTP-only production
# deploy (e.g. a bare EC2 IP, before a domain+TLS is added).
COOKIE_SECURE=false
